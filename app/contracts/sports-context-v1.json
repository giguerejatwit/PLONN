{
  "contractVersion": "sports-context-v1",
  "scope": "Server-owned public evidence for one canonical event; no account, chat or injury data.",
  "limits": {
    "inputBytes": 32768,
    "projectedBytes": 32768,
    "facts": 48,
    "designations": 8,
    "sources": 24,
    "sourcesPerFact": 4
  },
  "event": {
    "sport": "NFL|NBA|MLB|NHL",
    "eventID": "espn:<digits>",
    "homeTeam": "exact full name",
    "awayTeam": "exact full name",
    "startISO": "UTC ISO8601"
  },
  "sourceFields": [
    "id",
    "provider",
    "url",
    "retrievedAt",
    "checkedAt",
    "sourceAsOf",
    "contentSHA256"
  ],
  "sourceTimes": "sourceAsOf is nullable actual provider issuance/update time. Retrieval is not issuance. checkedAt cannot be advanced without a successful source check.",
  "factFields": [
    "id",
    "team",
    "subject",
    "role",
    "metric",
    "value",
    "unit",
    "sample",
    "season",
    "phase",
    "period",
    "windowStart",
    "windowEnd",
    "sourceIDs",
    "derivation"
  ],
  "subject": {
    "kind": "team|player|league",
    "id": "provider-prefixed stable ID",
    "name": "exact source name"
  },
  "role": [
    "offense",
    "defense",
    "player",
    "reference"
  ],
  "sample": {
    "count": "positive integer",
    "unit": "games|attempts|shots|possessions|plate_appearances|batters_faced"
  },
  "phase": [
    "preseason",
    "regular",
    "postseason"
  ],
  "derivation": {
    "kind": "reported|per_game|percent|per_100|ratio",
    "numerator": "finite nonnegative number",
    "denominator": "positive number or null for reported"
  },
  "designationFields": [
    "id",
    "team",
    "kind",
    "state",
    "subject",
    "eventID",
    "sourceIDs",
    "reportedAt",
    "basis"
  ],
  "designationKind": [
    "starting_pitcher",
    "starting_goalie",
    "starting_lineup"
  ],
  "designationState": [
    "confirmed",
    "probable",
    "unknown"
  ],
  "designationBasis": [
    "provider_confirmed",
    "provider_probable",
    "not_reported"
  ],
  "designationUnknown": "subject and reportedAt may be null; absence never means healthy, available or confirmed. Workload never proves availability.",
  "coverageFields": [
    "team",
    "topic",
    "state",
    "reason",
    "sourceIDs"
  ],
  "coverageState": [
    "available",
    "partial",
    "missing"
  ],
  "coverageReason": [
    "supported",
    "partial_source",
    "not_supplied",
    "source_unavailable",
    "unsupported_metric",
    "no_reported_designation"
  ],
  "bundleFields": [
    "contractVersion",
    "event",
    "sources",
    "facts",
    "designations",
    "coverage"
  ],
  "projectionFields": [
    "contractVersion",
    "event",
    "fingerprint",
    "revision",
    "evaluatedAt",
    "state",
    "facts",
    "designations",
    "sources",
    "coverage",
    "excluded"
  ],
  "projectionState": [
    "fresh",
    "partial",
    "stale",
    "missing"
  ],
  "projectionExclusionReasons": [
    "source_stale",
    "sample_stale",
    "designation_stale",
    "event_started",
    "conflicting_designation"
  ],
  "freshnessSeconds": {
    "statistics": 86400,
    "recentWorkload": 21600,
    "designation": 21600
  },
  "api": [
    "validate_context(bundle, now)",
    "fingerprint(bundle, now)",
    "project_context(bundle, now)"
  ],
  "consumerRules": [
    "Validate before use. Use projected eligible facts only; never promote excluded stale context to current evidence.",
    "Keep numeric values and source IDs intact. Comparisons require matching metric, unit, season, phase and window; directional meaning belongs to reviewed narrative rules.",
    "Roles are explicit: MLB offense strikeouts describe batters striking out; defense strikeouts describe pitching strikeouts. These meanings are not interchangeable.",
    "NFL passAttemptShare is pass attempts divided by pass plus rush attempts; it is not full dropback share and does not establish tempo.",
    "NBA points do not establish possessions, pace or efficiency. Only verified explicit possessions/pace fields can supply them.",
    "Injury context is passed separately through injury_model_context.py. The final narrative request has its own combined 32KiB bound.",
    "No read-time fetching, generation, production activation, or alteration of the frozen91 report archive."
  ],
