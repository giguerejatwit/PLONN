    "resistance": "offense >= reference AND opposing allowance <= 0.90 times reference",
    "lowerScoring": "both offenses AND both defenses <= 0.90 times reference; NBA says lower efficiency, never game total",
    "pace": "both NBA team paces <=0.95 or >=1.05 times reference; no inference about scoring",
    "mixedScoring": "NFL: one offense >=1.10 reference, other <=0.90, both opposing allowances inclusively0.90..1.10; matching units/period/window and every sample>=3; no scoring direction prediction"
  },
